{
  "name": "fti-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "prepare:models": "node scripts/prepare-models.mjs",
    "prepare:media": "sh scripts/prepare-media.sh",
    "prepare:illustrations": "node scripts/prepare-illustrations.mjs",
    "prepare:previews": "node scripts/capture-previews.mjs",
    "postinstall": "mkdir -p public/vendor && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/vendor/"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "lenis": "1.3.27",
    "maplibre-gl": "6.13.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3"
  }
